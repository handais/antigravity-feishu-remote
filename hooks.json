{
  "feishu-stop-notify": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop-notify.mjs",
        "timeout": 15
      }
    ]
  },
  "feishu-risky-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-approval.mjs",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-approval.mjs",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-approval.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
